{
  "name": "retro",
  "private": true,
  "version": "0.0.0",
  "description": "Доска для ретроспектив в реальном времени — учебный проект курса agentic engineering",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check:format && npm run check:lint && npm run check:types && npm run check:trace && npm run test:unit && npm run test:int",
    "check:format": "biome format .",
    "check:lint": "biome lint .",
    "check:types": "tsc -b && tsc -p packages/crdt/tsconfig.test.json && tsc -p packages/client-core/tsconfig.test.json",
    "check:trace": "node tools/check-trace/index.mjs",
    "test:unit": "npm run test --workspaces --if-present",
    "test:int": "npm run test:int --workspaces --if-present",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "db:generate": "npm run db:generate -w apps/server",
    "db:migrate": "npm run db:migrate -w apps/server"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.20.2",
    "typescript": "5.9.3"
  }
}
